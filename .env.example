# ==========================================================================
# CROW MARKET — local development environment
# ==========================================================================

# Local dev uses SQLite so the app runs with zero external services.
DATABASE_URL="file:./dev.db"
# Production (PostgreSQL): set provider in prisma/schema.prisma to "postgresql"
# and use a connection string like:
# DATABASE_URL="postgresql://crow:crow@localhost:5432/crow_market?schema=public"

SESSION_SECRET="crow-dev-session-secret-change-me-in-production-000"

NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- AI providers (optional: app falls back to deterministic demo mode) ---
GROQ_API_KEY=""
GROQ_MODEL="llama-3.3-70b-versatile"
NVIDIA_API_KEY=""
NVIDIA_MODEL="meta/llama-3.1-70b-instruct"
NVIDIA_BASE_URL="https://integrate.api.nvidia.com/v1"

# --- Multimedia provider (optional) ---
LEONARDO_API_KEY=""
LEONARDO_BASE_URL="https://cloud.leonardo.ai/api/rest/v1"
# LEONARDO_MODEL_ID is the text-to-image model. Video uses the official
# image-to-video endpoint: POST /generations-image-to-video (no model id needed).
# Quota guard for AI videos per generation run (1-10, default 5).
VIDEO_MAX_PER_PRODUCT="5"

# Local simulation: only honored in development/test. Never enabled in production.
PAYMENTS_TEST_MODE="false"

# --- Payments: TESTNET ONLY (chain 97); never use real USDT ---
PAYMENT_PROVIDER="bsc_testnet"
PAYMENT_CHAIN_ID="97"
PAYMENT_USDT_BEP20_ADDRESS=""
# BEP-20 TEST token, NOT an official Tether testnet issuance.
PAYMENT_TOKEN_ADDRESS=""
PAYMENT_TOKEN_DECIMALS="18"
PAYMENT_REQUIRED_CONFIRMATIONS="12"
PAYMENT_BSC_RPC_URL=""
# Optional webhook hint authentication. Monitor does not require a webhook.
PAYMENT_WEBHOOK_SECRET=""