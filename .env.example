# =============================================================================
# CROW MARKET — Environment variables
# =============================================================================
# Copy this file to .env (local dev) or configure each variable in your
# hosting provider's dashboard (Vercel, Railway, Render, etc.).
#
# Variables prefixed NEXT_PUBLIC_ are exposed to the browser — never put
# secrets in them.
# =============================================================================


# -----------------------------------------------------------------------------
# DATABASE
# -----------------------------------------------------------------------------

# PostgreSQL — required for both production and local development.
# Local dev with Docker:
#   docker run --name crow-pg -e POSTGRES_USER=crow -e POSTGRES_PASSWORD=crow \
#     -e POSTGRES_DB=crow_market -p 5432:5432 -d postgres:16
#   Then: npx prisma migrate deploy && npx prisma db seed
#
# Cloud providers: Neon (neon.tech), Supabase, Railway, Render Postgres
# After setting the URL run: npx prisma migrate deploy
DATABASE_URL="postgresql://crow:crow@localhost:5432/crow_market?schema=public"

# SQLite is no longer the default provider. If you need zero-config local dev
# you can temporarily revert schema.prisma provider to "sqlite" and use:
# DATABASE_URL="file:./dev.db"


# -----------------------------------------------------------------------------
# SESSION / AUTH
# -----------------------------------------------------------------------------

# REQUIRED IN PRODUCTION. Generate with: openssl rand -hex 32
# The app will throw at startup if this is missing or still the default value.
SESSION_SECRET="crow-dev-session-secret-change-me-in-production-000"


# -----------------------------------------------------------------------------
# APP URL
# -----------------------------------------------------------------------------

# Used to build absolute URLs (OAuth callbacks, referral links, emails).
# No trailing slash.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Production example:
# NEXT_PUBLIC_APP_URL="https://crowmarket.app"


# -----------------------------------------------------------------------------
# AI PROVIDERS  (all optional — app falls back to deterministic demo mode)
# -----------------------------------------------------------------------------

# Groq — fast text generation (blueprints, course content)
GROQ_API_KEY=""
# Available models in your account (verified 2024):
#   qwen/qwen3.8-27b        ← recommended (best available for chat/generation)
#   openai/gpt-oss-20b
#   openai/gpt-oss-120b
# NOTE: llama-3.3-70b-versatile requires a different Groq plan/account tier.
GROQ_MODEL="qwen/qwen3.8-27b"

# NVIDIA NIM — fallback reasoning provider
NVIDIA_API_KEY=""
NVIDIA_MODEL="meta/llama-3.1-70b-instruct"
NVIDIA_BASE_URL="https://integrate.api.nvidia.com/v1"

# Leonardo.ai — cover images, lesson illustrations, AI videos
LEONARDO_API_KEY=""
LEONARDO_BASE_URL="https://cloud.leonardo.ai/api/rest/v1"
# Text-to-image model ID (default works for most use cases)
LEONARDO_MODEL_ID="b24e16ff-06e3-43eb-8d33-4416c2d75876"

# Max AI videos generated per product run (1–10, default 5)
VIDEO_MAX_PER_PRODUCT="5"


# -----------------------------------------------------------------------------
# PAYMENTS — BSC TESTNET (chain 97)
# -----------------------------------------------------------------------------
# CROW currently runs on BSC Testnet only. mainnet is blocked in code.
# For real USDT payments you must configure all variables below.
#
# To get a free testnet RPC: https://docs.bnbchain.org/docs/rpc
# To get testnet tokens: https://testnet.bnbchain.org/faucet-smart

PAYMENT_PROVIDER="bsc_testnet"
PAYMENT_CHAIN_ID="97"

# Your wallet address that receives USDT payments (BEP-20, BSC Testnet)
PAYMENT_USDT_BEP20_ADDRESS=""

# BEP-20 token contract address (testnet USDT)
PAYMENT_TOKEN_ADDRESS=""
PAYMENT_TOKEN_DECIMALS="18"

# Confirmations required before a payment is considered final
PAYMENT_REQUIRED_CONFIRMATIONS="12"

# BSC Testnet RPC endpoint
PAYMENT_BSC_RPC_URL=""

# Optional: shared secret for the /api/webhooks/payments endpoint
PAYMENT_WEBHOOK_SECRET=""


# -----------------------------------------------------------------------------
# PAYMENTS TEST MODE
# -----------------------------------------------------------------------------
# Simulates a completed payment without touching the blockchain.
# ONLY active when NODE_ENV=development or NODE_ENV=test.
# This variable is IGNORED in production — the code guard prevents it.
# Never set this to "true" in a production environment.
PAYMENTS_TEST_MODE="false"


# -----------------------------------------------------------------------------
# GOOGLE OAUTH  (optional)
# -----------------------------------------------------------------------------
# Omit both variables to hide the "Continue with Google" button entirely.
# Setup: https://console.cloud.google.com/apis/credentials
#   → Create OAuth 2.0 Client ID → Web application
#   → Authorized redirect URI: ${NEXT_PUBLIC_APP_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
